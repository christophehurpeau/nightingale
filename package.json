{
  "name": "nightingale-monorepo",
  "version": "18.2.0",
  "private": true,
  "description": "Logger for browser and node, see [nightingale](packages/nightingale) to get started !",
  "homepage": "https://github.com/christophehurpeau/nightingale",
  "bugs": {
    "url": "https://github.com/christophehurpeau/nightingale/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/nightingale.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsc -b",
    "clean:build": "pnpm -r --parallel run clean:build",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "generate:api": "typedoc --tsconfig tsconfig.doc.json",
    "lint": "pnpm run format && pnpm run lint:eslint",
    "lint:eslint": "NODE_OPTIONS=--max_old_space_size=4096 eslint --quiet .",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC POB_VITEST_COVERAGE=json,text vitest run --coverage",
    "test:coverage:generate": "TZ=UTC POB_VITEST_COVERAGE=json vitest run --coverage",
    "test:watch": "TZ=UTC vitest --watch",
    "tsc": "tsc -b",
    "watch": "pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "devDependencies": {
    "@pob/eslint-config": "67.1.1",
    "@pob/rollup-esbuild": "10.0.0",
    "@pob/root": "27.2.1",
    "@types/node": "24.10.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">= 11.0.0"
  }
}
